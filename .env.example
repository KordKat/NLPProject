# ---------------------------------------------------------------- STEM OS configuration
# Copy to .env (repo root). Relative paths are resolved against the repository root.

ENVIRONMENT=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# ---- PostgreSQL (application data) ----
POSTGRES_USER=stemos
POSTGRES_PASSWORD=stemos
POSTGRES_DB=stemos
DATABASE_URL=postgresql+psycopg://stemos:stemos@localhost:5432/stemos
# For a quick single-machine trial without Postgres you may use:
# DATABASE_URL=sqlite:///./storage/stemos.db

# ---- Neo4j (knowledge graph) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=stemos-neo4j
NEO4J_DATABASE=neo4j

# ---- KeawGPT ----
LLM_MODEL_NAME=KordAI/KeawGPT
LLM_LOAD_ON_STARTUP=true
LLM_LOAD_IN_4BIT=true
LLM_MAX_CONTEXT_TOKENS=16384
LLM_MAX_NEW_TOKENS=3072
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.9
LLM_ENABLE_REASONING=true

# ---- ArXiv FAISS retrieval ----
# Directory containing faiss.index, documents.jsonl, document_offsets.bin, manifest.json
FAISS_DIR=test_out_st/test_out_st
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
ARXIV_MIN_SCORE=0.30

# ---- Research loop ----
RESEARCH_MAX_ROUNDS=5
RESEARCH_MIN_NEW_EVIDENCE=1
RESEARCH_SOURCES_PER_FILTER_CALL=3

# ---- Web search ----
# true = search the web for every question; false = only when the planner/user asks for it
WEB_SEARCH_ALWAYS=true

# ---- Storage ----
STORAGE_DIR=storage
MAX_UPLOAD_MB=25

# ---- Code execution sandbox ----
# remote = isolated sandbox container (docker compose); local = subprocess (single trusted dev machine only)
SANDBOX_MODE=local
SANDBOX_URL=http://localhost:8090
SANDBOX_TOKEN=change-me-sandbox-token
SANDBOX_TIMEOUT=60
SANDBOX_MEMORY_MB=1024

# ---- PDF ----
PDF_ENGINE=auto

# ---- Rate limits (per minute) ----
RATE_LIMIT_ASSISTANT_PER_MINUTE=12
RATE_LIMIT_AUTH_PER_MINUTE=20

# ---- Frontend (vite dev proxy target) ----
VITE_API_PROXY=http://localhost:8000
